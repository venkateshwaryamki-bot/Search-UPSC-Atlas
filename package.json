{
  "name": "search-upsc-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive UPSC atlas of India for Android and iOS.",
  "scripts": {
    "build": "node build.mjs",
    "sync": "node build.mjs && npx cap sync",
